{
  "name": "streamliner-scaffold-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "node scripts/wait-for-api.mjs && vite",
    "api": "tsx src/server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "refresh-copilot-plugin": "node scripts/refresh-copilot-plugin.mjs",
    "preview": "concurrently -n api,preview --kill-others-on-fail \"npm:api\" \"npm:preview:web\"",
    "preview:web": "node scripts/wait-for-api.mjs && vite preview",
    "preview:worktree": "node scripts/preview-worktree.mjs",
    "preview:stop": "node scripts/preview-worktree.mjs --stop",
    "preview:status": "node scripts/preview-worktree.mjs --status",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs/design",
    "docs:build": "vitepress build docs/design",
    "docs:preview": "vitepress preview docs/design"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@github/copilot-sdk": "^0.3.0",
    "@xyflow/react": "^12.10.2",
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.3"
  }
}
