# Copy this file to .env and edit values for your local checkout.

# Legacy graph endpoint and default launch-context graph.
# Register a Project root under Workstreams > Add source to populate the dashboard.
STREAMLINER_GRAPH=.streamliner/workstreams/session-launching-and-tracking/graph.json

# Copilot SDK model used to synthesize launch context packages.
# Override this if your local Copilot account should use a different model.
STREAMLINER_CONTEXT_MODEL=claude-sonnet-4.6

# Local API binding. The defaults are shown here for clarity.
STREAMLINER_API_HOST=127.0.0.1
STREAMLINER_API_PORT=4319

# Optional portfolio prototype. Unset keeps its API unavailable.
# STREAMLINER_PROTO_CANVAS_PROJECT_ROOT=C:\work\example-project

# Optional graph-only exploration: disable automatic session discovery/summaries.
# STREAMLINER_INTERNAL_DISABLE_SESSION_WORKER=1

# Optional isolated workstream registries for disposable preview instances.
# STREAMLINER_WORKSTREAM_REGISTRY=.streamliner-preview\workstreams.json
# STREAMLINER_WORKSTREAM_SOURCE_REGISTRY=.streamliner-preview\sources.json
# STREAMLINER_RECENTS_PATH=.streamliner-preview\recents.json
# STREAMLINER_PREVIEW_READONLY=1

# Optional: set to debug for more verbose API logs under ~/.streamliner/state/logs/.
STREAMLINER_LOG_LEVEL=info
