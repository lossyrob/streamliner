{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\scripts\\streamliner-signal.mjs\" sessionStart",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/scripts/streamliner-signal.mjs\" sessionStart",
        "timeoutSec": 3
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\scripts\\streamliner-signal.mjs\" userPromptSubmitted",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/scripts/streamliner-signal.mjs\" userPromptSubmitted",
        "timeoutSec": 3
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\scripts\\streamliner-signal.mjs\" sessionEnd",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/scripts/streamliner-signal.mjs\" sessionEnd",
        "timeoutSec": 3
      }
    ]
  }
}
